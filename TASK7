-- Write a query to find all clubs from ‘England’
select * from CLUB where COUNTRY_ID in (select ID from COUNTRY where NAME='England');

select * from CLUB join COUNTRY on club.country_id=COUNTRY.id where country.NAME='England'; 

-- Write a query to display all the players whose coach is from the same country
select * from PLAYERS where COUNTRY_ID in (select COUNTRY_ID from COACH where ID in (select COACH_ID from CLUB where ID=PLAYERS.CLUB_ID));

select players.id,players.name,players.age,players.goals,players.club_id,players.country_id from players join coach on players.country_id = coach.country_id join club on club.coach_id = coach.id where club.id =players.club_id;

-- Write a query to find all players whose club is from the same country
select * from PLAYERS where COUNTRY_ID in(select COUNTRY_ID from CLUB where ID= PLAYERS.CLUB_ID);

select players.id,players.name,players.age,players.goals,players.club_id,players.country_id from players join club on players.country_id=club.country_id where club.id=players.club_id;

-- Write a query to find all coaches who are coaching for teams from different countries and ages below 59 order by age.
select * from COACH where AGE<59 and COUNTRY_ID not in (select COUNTRY_ID from CLUB where COACH_ID=COACH.ID) order by AGE;

select coach.name from coach join club on coach.id=club.coach_id where age<59 and coach.country_id <> club.country_id ;

